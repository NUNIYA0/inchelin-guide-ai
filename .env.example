OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Restaurant candidate provider
RESTAURANT_DATA_SOURCE=naver
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
NAVER_LOCAL_SEARCH_API_URL=https://naverapihub.apigw.ntruss.com/search/v1/local

# NAVER Cloud Maps: Geocoding / Reverse Geocoding
NAVER_MAPS_API_KEY_ID=
NAVER_MAPS_API_KEY=
NAVER_GEOCODE_API_URL=https://maps.apigw.ntruss.com/map-geocode/v2/geocode
NAVER_REVERSE_GEOCODE_API_URL=https://maps.apigw.ntruss.com/map-reversegeocode/v2/gc

# Server-only provider diagnostics. Never logs credentials.
PROVIDER_DEBUG_LOGS=false
